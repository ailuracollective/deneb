{
  "name": "deneb",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm run build:client && nest build",
    "build:client": "vite build",
    "format": "prettier --write \"src/api/**/*.ts\" \"test/**/*.ts\" \"src/web/**/*.{ts,tsx,css}\"",
    "start": "NODE_ENV=production nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc -b tsconfig.json tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vite build && vitest run --config ./test/vitest-e2e.config.mts"
  },
  "dependencies": {
    "@ailura/nestjs-hono-adapter": "file:../nestjs-hono-adapter/packages/core/ailura-nestjs-hono-adapter-2.2.0.tgz",
