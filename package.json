    "class-validator": "^0.15.1",
    "handlebars": "^4.7.10",
    "hono": "^4.13.13",
    "mathjs": "^15.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
